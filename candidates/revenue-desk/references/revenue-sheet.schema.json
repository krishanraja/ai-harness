{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revenue-sheet/1",
  "title": "Revenue sheet",
  "description": "One venture's revenue sheet: readings, the blind veto, the stage check, the constraint, the reach check, at most one test card, the ask and the day-14 outcome. Kept in the engine's ignored local path, never committed. scripts/validate_sheet.py checks the rules a schema cannot hold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "venture",
    "repo",
    "harness_skill_sha",
    "made_on",
    "adapter",
    "stage",
    "readings",
    "standing",
    "constraint",
    "reach",
    "recalibration",
    "test_card",
    "offer_terms",
    "dissent",
    "ask",
    "outcome",
    "figures",
    "sheet_sha256"
  ],
  "properties": {
    "schema": {
      "const": "revenue-sheet/1"
    },
    "venture": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "harness_skill_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "made_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "adapter": {
      "type": "object",
      "required": [
        "path",
        "read"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "boolean"
        },
        "held": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "verdict",
        "buyer_seen",
        "reason",
        "reading_plan"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "measure-first",
            "run"
          ]
        },
        "buyer_seen": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "reading_plan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "step",
          "unit",
          "value",
          "source",
          "as_of",
          "better",
          "sight",
          "blind_reason",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "step": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "count",
              "usd",
              "rate"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "private"
              },
              {
                "type": "null"
              }
            ]
          },
          "share": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "better": {
            "enum": [
              "up",
              "down"
            ]
          },
          "sight": {
            "enum": [
              "fresh",
              "blind"
            ]
          },
          "blind_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "standing": {
      "enum": [
        "blind",
        "behind",
        "on track",
        "clear"
      ]
    },
    "constraint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "step",
            "slice",
            "reason"
          ],
          "properties": {
            "step": {
              "type": "string"
            },
            "slice": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "reach": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "volume",
            "steps",
            "target",
            "floor",
            "expected",
            "stretch",
            "verdict",
            "assumptions"
          ],
          "properties": {
            "unit": {
              "enum": [
                "count",
                "usd",
                "rate"
              ]
            },
            "volume": {
              "type": "number",
              "minimum": 0
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "rate"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "target": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "floor": {
              "type": "number"
            },
            "expected": {
              "type": "number"
            },
            "stretch": {
              "type": "number"
            },
            "verdict": {
              "enum": [
                "reachable",
                "gap",
                "cannot-be-true"
              ]
            },
            "assumptions": {
              "type": "object",
              "required": [
                "rates_source",
                "window",
                "sample",
                "trust_band"
              ],
              "properties": {
                "rates_source": {
                  "type": "string",
                  "minLength": 1
                },
                "window": {
                  "type": "string",
                  "minLength": 1
                },
                "sample": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "trust_band": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            }
          }
        }
      ]
    },
    "recalibration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "proposed_to",
            "reason"
          ],
          "properties": {
            "proposed_to": {
              "const": "Krish"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "test_card": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "step",
            "unit",
            "hypothesis",
            "variable",
            "primary_metric",
            "guardrail_metric",
            "prediction",
            "stop_rule",
            "kill_rule",
            "review_date",
            "touches_offer",
            "owner"
          ],
          "properties": {
            "step": {
              "type": "string"
            },
            "unit": {
              "enum": [
                "count",
                "usd",
                "rate"
              ]
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "variable": {
              "type": "string",
              "minLength": 1
            },
            "primary_metric": {
              "type": "string",
              "minLength": 1
            },
            "guardrail_metric": {
              "type": "string",
              "minLength": 1
            },
            "prediction": {
              "type": "object",
              "required": [
                "floor",
                "expected",
                "stretch"
              ],
              "additionalProperties": false,
              "properties": {
                "floor": {
                  "type": "number"
                },
                "expected": {
                  "type": "number"
                },
                "stretch": {
                  "type": "number"
                }
              }
            },
            "stop_rule": {
              "type": "string",
              "minLength": 1
            },
            "kill_rule": {
              "type": "string",
              "minLength": 1
            },
            "review_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "touches_offer": {
              "type": "boolean"
            },
            "council_unanimous": {
              "type": "boolean"
            },
            "owner": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "offer_terms": {
      "type": "object",
      "required": [
        "result",
        "rules_checked",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "held",
            "unavailable",
            "not-applicable"
          ]
        },
        "rules_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "dissent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "seat",
            "words"
          ],
          "properties": {
            "seat": {
              "type": "string",
              "minLength": 1
            },
            "words": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "ask": {
      "type": "object",
      "required": [
        "raise",
        "trigger",
        "open_ask",
        "venture_asks_this_week",
        "fleet_asks_this_week",
        "stage",
        "wall",
        "why"
      ],
      "properties": {
        "raise": {
          "type": "boolean"
        },
        "trigger": {
          "enum": [
            "none",
            "sunday-board",
            "newly-blind",
            "newly-breached"
          ]
        },
        "open_ask": {
          "type": "boolean"
        },
        "venture_asks_this_week": {
          "type": "integer",
          "minimum": 0
        },
        "fleet_asks_this_week": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "const": "plan"
        },
        "wall": {
          "const": "strategy"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "actual",
            "source",
            "as_of"
          ],
          "properties": {
            "actual": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "private"
                }
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "bias": {
              "type": "number"
            },
            "landed": {
              "enum": [
                "below-floor",
                "between",
                "above-stretch"
              ]
            }
          }
        }
      ]
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "source",
          "as_of"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "const": "private"
              }
            ]
          },
          "unit": {
            "enum": [
              "count",
              "usd",
              "rate"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "sheet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
