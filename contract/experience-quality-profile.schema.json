{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindmake.co/ai-harness/experience-quality-profile.schema.json",
  "title": "Experience quality project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "projectId", "stateRoute", "owners", "surfaces", "requiredCoverage", "briefFidelity", "feedbackReconciliation", "reviewReadiness", "presentationFirewall", "continuity", "blindPanel", "releaseEvidence", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "1.3.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "stateRoute": { "type": "string", "minLength": 1 },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestration", "taste", "implementation", "taskValidation", "completion", "materialApproval", "exceptions", "release"],
      "properties": {
        "orchestration": { "const": "build-apps-with-krish" },
        "taste": { "const": "krish-design" },
        "implementation": { "const": "krish-build" },
        "taskValidation": { "const": "ux-testing-agent" },
        "completion": { "const": "verification-loop" },
        "materialApproval": { "const": "Krish" },
        "exceptions": { "const": "Krish" },
        "release": { "const": "explicit-action-time-approval" }
      }
    },
    "surfaces": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredCoverage": { "type": "array", "minItems": 15, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "briefFidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "ownerDirectionIsHardGate", "candidateTraceRequired", "scoresCannotOverride", "blockOnUnresolved", "requiredFields", "authoritativeSources"],
      "properties": {
        "required": { "const": true },
        "ownerDirectionIsHardGate": { "const": true },
        "candidateTraceRequired": { "const": true },
        "scoresCannotOverride": { "const": true },
        "blockOnUnresolved": { "const": true },
        "requiredFields": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authoritativeSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "feedbackReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "ledger", "verbatimRequired", "decisionNotesRequired", "overallNoteRequired", "submissionIsApproval", "blockOnUnresolved", "judgesReceiveRequirements", "blockingStatuses", "requiredFields"],
      "properties": {
        "required": { "const": true },
        "ledger": { "type": "string", "minLength": 1 },
        "verbatimRequired": { "const": true },
        "decisionNotesRequired": { "const": true },
        "overallNoteRequired": { "const": true },
        "submissionIsApproval": { "const": false },
        "blockOnUnresolved": { "const": true },
        "judgesReceiveRequirements": { "const": true },
        "blockingStatuses": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["open", "implemented-awaiting-review"] } },
        "requiredFields": { "type": "array", "minItems": 13, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockingStatuses", "requiredChecks", "selfOwnedRuntime", "candidateBoundEvidence"],
      "properties": {
        "blockingStatuses": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": ["fail", "inconclusive", "not_run"] } },
        "requiredChecks": { "type": "array", "minItems": 15, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "selfOwnedRuntime": { "const": true },
        "candidateBoundEvidence": { "const": true }
      }
    },
    "presentationFirewall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "failClosed", "candidateManifestRequired", "singleDomScrollContextRequired", "embeddedFrameIntegrationAllowed", "candidateBoundReceiptRequired", "directReviewCommandRequired", "adversarialSelfTestRequired", "blockingStatuses"],
      "properties": {
        "required": { "const": true },
        "failClosed": { "const": true },
        "candidateManifestRequired": { "const": true },
        "singleDomScrollContextRequired": { "const": true },
        "embeddedFrameIntegrationAllowed": { "const": false },
        "candidateBoundReceiptRequired": { "const": true },
        "directReviewCommandRequired": { "const": true },
        "adversarialSelfTestRequired": { "const": true },
        "blockingStatuses": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["fail", "inconclusive", "not_run", "stale", "mismatch", "missing"] }
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "requiredFields", "blockOnAnyUnresolved"],
      "properties": {
        "required": { "const": true },
        "requiredFields": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "blockOnAnyUnresolved": { "const": true }
      }
    },
    "blindPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "ownerHistoryVisible", "minimumIndependentJurors", "roles", "scoresCannotOverrideHardGates"],
      "properties": {
        "required": { "const": true },
        "ownerHistoryVisible": { "const": false },
        "minimumIndependentJurors": { "type": "integer", "minimum": 6 },
        "scoresCannotOverrideHardGates": { "const": true },
        "roles": {
          "type": "array", "minItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "surface", "coverage"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "surface": { "type": "string", "minLength": 1 },
              "coverage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "releaseEvidence": {
      "type": "object", "additionalProperties": false, "required": ["automatedBrowsers", "physicalDevices", "physicalCannotBeInferred"],
      "properties": {
        "automatedBrowsers": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "physicalDevices": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "physicalCannotBeInferred": { "const": true }
      }
    },
    "commands": {
      "type": "object", "additionalProperties": false, "required": ["definitions", "reviewReadiness", "presentation", "continuity", "blindPanel", "status"],
      "properties": {
        "definitions": { "type": "string", "minLength": 1 },
        "reviewReadiness": { "type": "string", "minLength": 1 },
        "presentation": { "type": "string", "minLength": 1 },
        "continuity": { "type": "string", "minLength": 1 },
        "blindPanel": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
