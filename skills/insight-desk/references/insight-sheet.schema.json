{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight-sheet/1",
  "title": "Insight sheet",
  "description": "One insight desk run for one venture: the insight, up to three ideas and how each was screened. Rules a schema cannot hold (the lead passed every test, the blind passes agree, methods come from three categories, no scores anywhere, sheet_sha256 matches) are checked by scripts/validate_sheet.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "venture",
    "repo",
    "harness_skill_sha",
    "made_at",
    "north_star",
    "stall_check",
    "insights",
    "chosen_insight",
    "discarded_obvious",
    "methods_used",
    "ideas",
    "consults",
    "lead",
    "blind_passes",
    "sheet_sha256"
  ],
  "properties": {
    "schema": { "const": "insight-sheet/1" },
    "venture": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "harness_skill_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "made_at": { "type": "string", "format": "date-time" },
    "north_star": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "urgency", "current", "as_of"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "urgency": { "type": "integer", "minimum": 1, "maximum": 5 },
        "current": { "type": ["number", "null"] },
        "as_of": { "type": ["string", "null"], "format": "date" }
      }
    },
    "stall_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis", "evidence"],
      "properties": {
        "diagnosis": { "enum": ["idea", "distribution", "offer", "attribution", "measurement"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "insights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/insight" }
    },
    "chosen_insight": { "type": "integer", "minimum": 0, "maximum": 2 },
    "discarded_obvious": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "methods_used": {
      "description": "The three to five methods the divergence used, from at least three categories in references/methods-by-category.md; every idea's method is one of them. scripts/validate_sheet.py checks the category spread.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/idea" }
    },
    "consults": {
      "type": "array",
      "items": { "$ref": "#/$defs/consult" }
    },
    "lead": { "type": ["string", "null"] },
    "blind_passes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/blind_pass" }
    },
    "sheet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "wants", "but", "because"],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "wants": { "type": "string", "minLength": 1 },
        "but": { "type": "string", "minLength": 1 },
        "because": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "read_at": { "type": "string", "format": "date" },
        "assumption": { "const": true }
      },
      "oneOf": [
        { "required": ["source", "read_at"], "not": { "required": ["assumption"] } },
        { "required": ["assumption"], "not": { "anyOf": [{ "required": ["source"] }, { "required": ["read_at"] }] } }
      ]
    },
    "test_result": {
      "type": "object",
      "required": ["result", "reason"],
      "properties": {
        "result": { "enum": ["pass", "fail", "unavailable"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "mechanic", "idea_level", "method", "channel_role", "conversion_path", "kill_condition", "tests"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "claim": { "type": "string", "minLength": 1 },
        "mechanic": { "type": "string", "minLength": 1 },
        "idea_level": { "enum": ["execution", "campaign", "platform", "business", "measurement"] },
        "method": { "type": "string", "minLength": 1 },
        "channel_role": { "type": "string", "minLength": 1 },
        "conversion_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offer", "link", "why_act"],
          "properties": {
            "offer": { "type": "string", "minLength": 1 },
            "link": { "type": "string", "minLength": 1 },
            "why_act": { "type": "string", "minLength": 1 }
          }
        },
        "kill_condition": { "type": "string", "minLength": 1 },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specificity", "share", "analogue", "floor", "kill_the_favourite"],
          "properties": {
            "specificity": { "$ref": "#/$defs/test_result", "unevaluatedProperties": false },
            "share": { "$ref": "#/$defs/test_result", "unevaluatedProperties": false },
            "analogue": {
              "$ref": "#/$defs/test_result",
              "properties": {
                "url": { "type": ["string", "null"] },
                "read_at": { "type": ["string", "null"], "format": "date" }
              },
              "required": ["url", "read_at"],
              "unevaluatedProperties": false
            },
            "floor": { "$ref": "#/$defs/test_result", "unevaluatedProperties": false },
            "kill_the_favourite": { "$ref": "#/$defs/test_result", "unevaluatedProperties": false }
          }
        }
      }
    },
    "consult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "op", "result", "ref"],
      "properties": {
        "engine": { "enum": ["divergence-engine", "divergent-thinker", "humour-engine"] },
        "op": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "flagged", "unavailable"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "blind_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reader", "order", "lead"],
      "properties": {
        "reader": { "type": "string", "minLength": 1 },
        "order": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
        "lead": { "type": ["string", "null"] }
      }
    }
  }
}
